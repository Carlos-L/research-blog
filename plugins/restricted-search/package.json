{
  "name": "@carlos-research/restricted-search",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js"
  },
  "quartz": {
    "name": "restricted-search",
    "displayName": "Restricted Full Text Search",
    "category": ["transformer", "emitter"],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 890,
    "defaultEnabled": true,
    "defaultOptions": {
      "passwordEnv": "QUARTZ_RESTRICTED_PASSWORD",
      "iterations": 600000,
      "outputPath": "static/restrictedSearchIndex.json"
    }
  }
}
